<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pets="clr-namespace:DynamicIsland.Pets"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="784" Height="544" Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Background="#FF131417"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- No title bar; Windows still draws the rounded corners and shadow (see ApplyWin11Frame) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar nav item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="12" Background="Transparent" Padding="12,0">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Water}" HorizontalAlignment="Left" Margin="-8,0,0,0" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Width="26"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#0FFFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim overlay scrollbar: no track, faint pill thumb that brightens and widens on hover -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Arrow">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Width="4" CornerRadius="2" Background="#2EFFFFFF" HorizontalAlignment="Center" MinHeight="36"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Width" Value="6"/>
                                                        <Setter TargetName="T" Property="CornerRadius" Value="3"/>
                                                        <Setter TargetName="T" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="T" Property="Width" Value="6"/>
                                                        <Setter TargetName="T" Property="CornerRadius" Value="3"/>
                                                        <Setter TargetName="T" Property="Background" Value="#8CFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay-style scroll viewer: content uses the full width, bar floats on top at the right edge -->
        <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF131417">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="#0AFFFFFF" MouseLeftButtonDown="Drag">
                <Grid Margin="14,18,14,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,22">
                            <pets:PetView x:Name="HeaderPet" Width="38" Height="38"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Dynamic Island" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Dim}"/>
                            </StackPanel>
                        </StackPanel>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="General" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavIsland" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="Island" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPet" Style="{StaticResource NavItem}" Tag="&#xEB51;" Content="Water &amp; pet" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSync" Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Phone sync" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDev" Style="{StaticResource NavItem}" Tag="&#xE943;" Content="Developer" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" Checked="Nav_Checked"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Bottom" Margin="6,0" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                               Text="Changes save instantly."/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Background="Transparent" MouseLeftButtonDown="Drag">
                    <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,6,0,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Width="32" Height="32"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,16,0" Click="Close_Click" ToolTip="Close"/>
                </Grid>
                <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto"
                              local:SmoothScroll.Enabled="True" Margin="0,0,6,16">
                    <StackPanel x:Name="Page" Margin="28,0,20,8"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
